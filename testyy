# I2C スキャン
# =====================================================================
EXPECT = {0x28: "BNO055", 0x29: "VL53L1X", 0x30: "IM920-HAT", 0x42: "SAM-M10Q", 0x77: "BME280"}


def scan(bus, rep):
    rep.section("I2C スキャン (bus 1)")
    found = []
    for a in range(0x08, 0x78):
        try:
            # i2cdetect と同じ方式: 0x30-0x37, 0x50-0x5F は読み出し, それ以外はクイック書き込み
            if 0x30 <= a <= 0x37 or 0x50 <= a <= 0x5F:
                bus.read_byte(a)
            else:
                bus.write_quick(a)
            found.append(a)
        except OSError:
            pass
    rep.log("  検出: " + (" ".join(f"0x{a:02X}" for a in found) or "なし"))
    for a, n in EXPECT.items():
        hit = a in found or (a == 0x77 and 0x76 in found)
        rep.judge("I2C", f"0x{a:02X} {n}", hit, "応答あり" if hit else "応答なし")
    return found


# =====================================================================
# 連続モニタ
# =====================================================================
def monitor(bus, targets, rate, csv_path):
    bme = bno = tof = gn = None
    if "bme280" in targets:
        try: bme = BME280(bus)
        except Exception as e: print("BME280 初期化失敗:", e)
    if "bno055" in targets:
        try: bno = BNO055(bus)
        except Exception as e: print("BNO055 初期化失敗:", e)
    if "tof" in targets:
        try: tof = ToF(); tof.dev.timing_budget = 50
        except Exception as e: print("VL53L1X 初期化失敗:", e)
    if "gnss" in targets:
        gn = UbloxI2C(bus)

    keys = ["time_s", "temp_C", "press_hPa", "alt_m", "hum_pct",
            "heading", "roll", "pitch", "ax", "ay", "az", "gx", "gy", "gz",
            "lin_ax", "lin_ay", "lin_az", "calib",
            "tof_cm", "fix_type", "num_sv", "lat", "lon", "h_msl", "h_acc"]
    fp = open(csv_path, "w", newline="", encoding="utf-8") if csv_path else None
    wr = csv.DictWriter(fp, fieldnames=keys) if fp else None
    if wr:
        wr.writeheader()

    t0 = time.time()
    tof_cm = None
    gn_last = {}
    gn_next = 0.0
    print("Ctrl+C で終了")
    try:
        while True:
            ts = time.time()
            row = {"time_s": round(ts - t0, 3)}
            out = [f"{row['time_s']:8.2f}"]
            try:
                if bme:
                    t, p, h = bme.read()
                    row.update(temp_C=round(t, 2), press_hPa=round(p, 3),
                               alt_m=round(p2alt(p), 2), hum_pct=round(h, 1))
                    out.append(f"{t:5.1f}℃ {p:8.2f}hPa")
                if bno:
                    e, a, gy, la, c = bno.eul(), bno.acc(), bno.gyr(), bno.lia(), bno.calib()
                    row.update(heading=e[0], roll=e[1], pitch=e[2],
                               ax=a[0], ay=a[1], az=a[2], gx=gy[0], gy=gy[1], gz=gy[2],
                               lin_ax=la[0], lin_ay=la[1], lin_az=la[2], calib="".join(map(str, c)))
                    out.append(f"H{e[0]:6.1f} R{e[1]:6.1f} P{e[2]:6.1f} cal{''.join(map(str, c))}")
                if tof:
                    if tof.dev.data_ready:
                        tof_cm = tof.dev.distance
                        tof.dev.clear_interrupt()
                    row["tof_cm"] = tof_cm
                    out.append(f"ToF {tof_cm if tof_cm is not None else '---':>6} cm")
                if gn:
                    if ts >= gn_next:   # NAV-PVTは1Hzで十分
                        gn_next = ts + 1.0
                        pv = gn.poll(0x01, 0x07, timeout=0.3)
                        if pv and len(pv) >= NAV_PVT.size:
                            gn_last = parse_pvt(pv)
                    if gn_last:
                        row.update({k: gn_last[k] for k in ("fix_type", "num_sv", "lat", "lon", "h_msl", "h_acc")})
                        out.append(f"GNSS {FIX_NAME.get(gn_last['fix_type'], '?')} sv{gn_last['num_sv']}")
            except OSError as ex:
                out.append(f"I2Cエラー: {ex}")
            print(" | ".join(out))
            if wr:
                wr.writerow(row)
                fp.flush()
            time.sleep(max(0.0, 1.0 / rate - (time.time() - ts)))
    except KeyboardInterrupt:
        print("\n終了")
    finally:
        if tof:
            tof.close()
        if fp:
            fp.close()
            print("CSV保存:", csv_path)


# =====================================================================
# main
# =====================================================================
def main():
    ap = argparse.ArgumentParser(description="CanSat センサ試験")
    ap.add_argument("--only", default="bme280,bno055,tof,gnss", help="bme280,bno055,tof,gnss")
    ap.add_argument("--auto", action="store_true", help="動的試験(操作が必要なもの)を飛ばす")
    ap.add_argument("--secs", type=float, default=5.0, help="静的試験の計測秒数")
    ap.add_argument("--tof-refs", default="20,50,100", help="ToF距離試験の基準距離[cm] (カンマ区切り)")
    ap.add_argument("--gnss-timeout", type=float, default=60.0, help="GNSS 3D Fixを待つ最大秒数")
    ap.add_argument("--monitor", action="store_true", help="試験ではなく連続表示モード")
    ap.add_argument("--rate", type=float, default=5.0, help="モニタ表示レート[Hz]")
    ap.add_argument("--csv", default=None, help="モニタ時のCSV保存先")
    ap.add_argument("--no-report", action="store_true", help="レポートファイルを作らない")
    a = ap.parse_args()
    targets = {x.strip().lower() for x in a.only.split(",") if x.strip()}

    with SMBus(BUS_NO) as bus:
        if a.monitor:
            monitor(bus, targets, a.rate, a.csv)
            return 0

        path = None if a.no_report else dt.datetime.now().strftime("report_%Y%m%d_%H%M%S.txt")
        rep = Report(path)
        rep.log(f"CanSat センサ試験  {dt.datetime.now():%Y-%m-%d %H:%M:%S}")
        rep.log(f"対象: {', '.join(sorted(targets))}   動的試験: {'なし' if a.auto else 'あり'}")

        scan(bus, rep)

        tests = [
            ("bme280", lambda: test_bme280(bus, rep, a.auto, a.secs)),
            ("bno055", lambda: test_bno055(bus, rep, a.auto, a.secs)),
            ("tof", lambda: test_tof(rep, a.auto, a.secs,
                                     [float(x) for x in a.tof_refs.split(",") if x.strip()])),
            ("gnss", lambda: test_gnss(bus, rep, a.gnss_timeout)),
        ]
        for key, fn in tests:
            if key not in targets:
                continue
            try:
                fn()
            except ImportError as e:
                rep.judge(key, "ライブラリ", False, f"{e}  → venv を有効化したか確認")
            except OSError as e:
                rep.judge(key, "I2C通信", False, str(e))
                if key == "bno055":
                    rep.log("    ヒント: BNO055はI2Cクロックストレッチを使うため、Piでは"
                            " /boot/firmware/config.txt に dtparam=i2c_arm_baudrate=10000 を追加すると安定することが多い")
            except Exception as e:
                rep.judge(key, "試験中断", False, f"{type(e).__name__}: {e}")

        rep.section("まとめ")
        sensors = []
        for s, _, _ in rep.summary:
            if s not in sensors:
                sensors.append(s)
        all_ok = True
        for s in sensors:
            r = [ok for ss, _, ok in rep.summary if ss == s and ok is not None]
            ng = [it for ss, it, ok in rep.summary if ss == s and ok is False]
            if ng:
                all_ok = False
            rep.log(f"  {s:<8s} 合格 {r.count(True)}/{len(r)}" + (f"   不合格: {', '.join(ng)}" if ng else ""))
        rep.log("\n  総合判定: " + ("合格" if all_ok else "不合格あり"))
        if path:
            rep.log(f"  レポート: {path}")
        rep.close()
        return 0 if all_ok else 1


if __name__ == "__main__":
    sys.exit(main())
